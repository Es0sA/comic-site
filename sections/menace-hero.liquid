{{ 'component-menace-hero.css' | asset_url | stylesheet_tag }}

<div class="menace-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="menace-hero__media">
    <img
      src="{{ 'heartline-hero-menace.jpg' | asset_url }}"
      alt="{{ section.settings.heading | strip_html | escape }}"
      width="1440"
      height="1920"
      loading="eager"
      fetchpriority="high"
    >
  </div>
  <div class="menace-hero__content page-width">
    <div class="menace-hero__box">
      {%- if section.settings.heading != blank -%}
        <h1 class="menace-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="button button--primary"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Menace hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Menace army"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Menace hero"
    }
  ]
}
{% endschema %}
