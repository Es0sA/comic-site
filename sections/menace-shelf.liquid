{{ 'component-menace-shelf.css' | asset_url | stylesheet_tag }}

{%- assign filter_tag = section.settings.filter_tag | strip | downcase -%}

{%- assign product_count = section.settings.collection.products.size -%}
{%- if filter_tag != blank -%}
  {%- assign product_count = 0 -%}
  {%- for product in section.settings.collection.products -%}
    {%- assign product_tags_down = product.tags | join: ',' | downcase -%}
    {%- if product_tags_down contains filter_tag -%}
      {%- assign product_count = product_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if section.settings.collection != blank and product_count > 0 -%}
  <div class="menace-shelf color-{{ section.settings.color_scheme }} gradient">
    <div class="menace-shelf__header page-width">
      {%- if section.settings.title != blank -%}
        <h2 class="menace-shelf__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all -%}
        <a href="{{ section.settings.collection.url }}" class="menace-shelf__view-all link underlined-link">
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      {%- endif -%}
    </div>

    <slider-component class="slider-mobile-gutter menace-shelf__slider">
      <ul id="Slider-{{ section.id }}" class="menace-shelf__list slider slider--tablet grid--peek" role="list">
        {%- assign shown = 0 -%}
        {%- for product in section.settings.collection.products -%}
          {%- assign product_tags_down = product.tags | join: ',' | downcase -%}
          {%- if filter_tag == blank or product_tags_down contains filter_tag -%}
            {%- assign shown = shown | plus: 1 -%}
            <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="menace-shelf__item grid__item slider__slide">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'square',
                show_secondary_image: true,
                show_vendor: false,
                show_rating: false,
                show_quick_add: true,
                section_id: section.id
              %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="slider-buttons no-js-hidden">
        <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
          {% render 'icon-caret' %}
        </button>
        <div class="slider-counter caption">
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total">{{ shown }}</span>
        </div>
        <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
          {% render 'icon-caret' %}
        </button>
      </div>
    </slider-component>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Menace shelf",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "filter_tag",
      "label": "Filter by tag (optional)",
      "info": "Only show products from the collection above that have this tag, e.g. \"physical\" or \"digital\". Leave blank to show the whole collection. Row is hidden automatically if nothing matches."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"view all\" link",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Menace shelf"
    }
  ]
}
{% endschema %}
